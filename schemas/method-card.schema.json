{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "file", "problem_types", "python_callable", "matlab_callable", "fixture_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "file": {"type": "string", "pattern": "^knowledge/methods/.+\\.md$"},
    "problem_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "python_callable": {"type": ["string", "null"]},
    "matlab_callable": {"type": ["string", "null"]},
    "fixture_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

