{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_id", "read_status", "coverage", "key_findings", "evidence"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "read_status": {"enum": ["full-read", "partial-read", "metadata-only", "blocked", "dead-link"]},
    "coverage": {"type": "string", "minLength": 8},
    "key_findings": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}}
  },
  "additionalProperties": false
}

