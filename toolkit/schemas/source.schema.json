{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM source catalog",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "defaults": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id", "title", "locator", "source_type", "authority_level",
        "read_status", "access_status", "license_status", "access_date",
        "coverage", "repository_targets", "evidence_locations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 2},
        "locator": {"type": "string", "minLength": 4},
        "url": {"type": "string", "format": "uri"},
        "source_type": {
          "enum": ["official-web", "course", "book", "documentation", "paper", "data", "repository", "bibliographic"]
        },
        "authority_level": {"enum": ["A", "B", "C"]},
        "read_status": {
          "enum": ["full-read", "partial-read", "metadata-only", "blocked", "dead-link"]
        },
        "access_status": {
          "enum": ["public", "login-required", "paid", "blocked", "dead-link", "unknown"]
        },
        "license_status": {"type": "string", "minLength": 2},
        "access_date": {"type": "string", "format": "date"},
        "coverage": {"type": "string", "minLength": 8},
        "repository_targets": {"type": "array", "items": {"type": "string"}},
        "evidence_locations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}

